#!/bin/sh
#
#
#   runroot - a utility to run commands as root and give visual indicators
#
#

_prog=${0##*/}
_color_reset=$(printf '\033[0m')
_color_red_sgr=$(printf '48;2;64;0;0')
RUNROOT_BACKGROUND="${RUNROOT_BACKGROUND-$_color_red_sgr}"

err_msg() { >&2 printf '\033[1;31m%s\033[0m\n' " $*"; }

_help() {
    cat <<EOF
 ${_prog}  --  a utility for running commands as root

[ options ]:
    -h, -H, --help    show this message

[ usage ]:
    Just give a command you want to run as root, examples:

    ${_prog} echo "hello from root"
    ${_prog} rm -rf / --no-preserve-root    (please don't run this one)
    ${_prog} apt update

EOF
    [ -n "${1:-}" ]
    exit $?
}

_check() {
    _prepare_rootcmd || :
    if [ -z "${_rootcmd:-}" ] && [ "$(id -u)" != 0 ]; then
        err_msg "Cannot escalate to root: no 'run0', 'pkexec' or 'lxqt-sudo' found in PATH (uid=$(id -u), not root)"
        return 1
    fi
    echo "All fine!"
    return 0
}

_parse_arguments() {
    case "${1:-}" in
        ''|--help|-h|-H) _help "$@"
            ;;
        --check) _check 
            ;;
        --) shift; _main "$@"
            ;;
        *) _main "$@"
            ;;
    esac
}

_prepare_rootcmd() {
    _rootcmd=""; _is_run0=0; _run0_extra=""; _tint=0;

    if [ -n "$RUNROOT_BACKGROUND" ] \
    && [ -z "${NO_COLOR:-}" ] \
    && [ "${TERM:-dumb}" != "dumb" ] \
    && [ -t 1 ]; then
    case "${SYSTEMD_TINT_BACKGROUND:-}" in
        0|false|no|off) ;;
        *) _tint=1 ;;
    esac
    fi  

    if [ "$(id -u)" = 0 ]; then _is_run0=0; _rootcmd=""
    elif _rootcmd="$(command -v run0)"; then 
        _is_run0=1
        if [ "$_tint" = 1 ]; then
            _run0_extra="--background=$RUNROOT_BACKGROUND"
        else
            _run0_extra="--background="  # also disables run0's implicit tint
        fi
    elif _rootcmd="$(command -v pkexec)"; then _is_run0=0;
    elif _rootcmd="$(command -v lxqt-sudo)"; then _is_run0=0;
    else return 1;
    fi
}

# Resolve a command name to an absolute path using the *caller's*
# environment (PATH/HOME/PWD) before privilege escalation resets them
# (sudo secure_path, pkexec minimal env, run0 root env).
# Prints resolved path on success, returns non-zero on failure
# (builtin, function, alias, unresolvable) -- caller keeps original.
_resolve_cmd_path() {
    _rc_cmd=${1:-}
    [ -n "$_rc_cmd" ] || return 1
    # don't touch option-like names; /usr/bin/env wrapper handles those
    case $_rc_cmd in -* ) return 1 ;; esac
    # leading ~/ (quoted, so the calling shell didn't expand it)
    # shellcheck disable=SC2088 # intentional literal ~/ match
    case $_rc_cmd in
        '~/'*) _rc_cmd=${HOME:-~}/${_rc_cmd#\~/} ;;
        '~') _rc_cmd=${HOME:-~} ;;
    esac
    case $_rc_cmd in
        */*)
            case $_rc_cmd in
                /*) printf '%s\n' "$_rc_cmd"; return 0 ;;
                *)
                    _rc_dir=${_rc_cmd%/*}
                    _rc_base=${_rc_cmd##*/}
                    if [ -n "$_rc_dir" ] && [ -d "$_rc_dir" ]; then
                        _rc_abs=$(cd -- "$_rc_dir" && pwd -P) || return 1
                        printf '%s\n' "$_rc_abs/$_rc_base"
                        return 0
                    fi
                    return 1
                    ;;
            esac
            ;;
        *)
            _rc_found=$(command -v "$_rc_cmd" 2>/dev/null) || return 1
            # bare name means builtin/function/alias -- keep as-is so the
            # target shell (run0 --via-shell) can still interpret it
            case $_rc_found in
                */*) printf '%s\n' "$_rc_found"; return 0 ;;
                *) return 1 ;;
            esac
            ;;
    esac
}

# the main function
# Replace argv[0] (or argv[2] behind /usr/bin/env --) with its absolute
# path when resolvable. Best-effort: never fails, never reorders args.
# NOTE: must run inline in _main (functions get their own $@ copy, so a
# helper cannot set the caller's positional params).
_main() {
    _prepare_rootcmd || { err_msg "Preparing root command failed."; return 1; }

    if [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; then
        set -- /usr/bin/env -- "$@"
    fi

    # Resolve via caller's PATH/HOME before escalating, so scripts in
    # ~/.local/bin (or other user-only PATH dirs) are found by root.
    # Absolute paths pass through run0/pkexec/lxqt-sudo unchanged.
    if [ "${1:-}" = /usr/bin/env ] && [ "${2:-}" = -- ] && [ $# -ge 3 ]; then
        _rr_resolved=$(_resolve_cmd_path "$3") && {
            _rr_bin=$1; _rr_sep=$2; _rr_cmd=$_rr_resolved; shift 3
            set -- "$_rr_bin" "$_rr_sep" "$_rr_cmd" "$@"
        }
    elif [ $# -ge 1 ]; then
        _rr_resolved=$(_resolve_cmd_path "$1") && {
            _rr_cmd=$_rr_resolved; shift
            set -- "$_rr_cmd" "$@"
        }
    fi
    unset _rr_bin _rr_sep _rr_cmd _rr_resolved

    if [ "$_is_run0" = 1 ]; then
    # native PTY re-injection, persists for whole `sh` session
    exec "$_rootcmd" "${_run0_extra:+$_run0_extra}" --via-shell -- "$@"
    fi

    if [ "$_tint" = 1 ]; then
        if _ptyfwd="$(command -v systemd-pty-forward)" && [ -n "${_ptyfwd:-}" ]; then
        # same PTY re-injection as run0 for pkexec/already-root
            if [ -z "$_rootcmd" ]; then
                exec "$_ptyfwd" --quiet --background="$RUNROOT_BACKGROUND" -- "$@"
            else
                exec "$_ptyfwd" --quiet --background="$RUNROOT_BACKGROUND" -- "$_rootcmd" "$@"
            fi
        fi
        # fallback only: best-effort, won't survive `sh` prompt redraws
        
        printf '%b' "\033[${RUNROOT_BACKGROUND}m"
        trap 'printf "%b" "$_color_reset"' INT TERM
        if [ -z "${_rootcmd:-}" ]; then
            "$@"; _st=$?
        else
            "$_rootcmd" "$@"; _st=$?
        fi
        trap - INT TERM
        printf '%b' "$_color_reset"
        return "$_st"
    fi

    if [ -z "${_rootcmd:-}" ]; then
        exec "$@"
    fi
    exec "$_rootcmd" "$@"
}

_parse_arguments "$@"
